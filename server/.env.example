# TNV Hub Portal - Environment Variables
# NEVER commit the real .env file or expose the service role key to the frontend!

# Supabase Project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-secret

# Aadhaar Encryption (AES-256-GCM - 32-byte hex or base64 key)
AADHAAR_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# Email (server/mail/mailer.js). Pick one provider:
#   resend     https://resend.com  Free: 3,000 emails/month, 100/day. Verify your domain first.
#   zeptomail  Zoho ZeptoMail (Zoho CPaaS). Pay as you go, 10,000 emails for about Rs 150.
#   log        Nothing is sent; emails only go to Admin > Email Status (default with no key).
MAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
# ZEPTOMAIL_TOKEN=your-send-mail-token
# ZEPTOMAIL_API_URL=https://cpaas.zoho.com/v1.1/email   (use the send URL your Zoho console shows)
MAIL_FROM="Tamil Nadu Volunteers <noreply@your-verified-domain.org>"
# MAIL_REPLY_TO=contact@your-verified-domain.org
# MAIL_DAILY_LIMIT=100
PORTAL_URL=https://tnv-hub.vercel.app

# Daily job (birthday emails + queued emails). Vercel Cron sends this as a Bearer token.
CRON_SECRET=a-long-random-string
