# TNV Hub Portal - Environment Variables
# NEVER commit the real .env file or expose the service role key to the frontend!

# Supabase Project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-secret

# Aadhaar Encryption (AES-256-GCM - 32-byte hex or base64 key)
AADHAAR_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# Transactional Email (Resend or SMTP)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="TNV Portal <noreply@tnvportal.org>"

# Portal Frontend URL (for login links in welcome/approval emails)
PORTAL_URL=https://portal.tnv.org
